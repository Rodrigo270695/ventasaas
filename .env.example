APP_NAME=Choko House
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Brevo (smtp-relay.brevo.com:587): si falla "Peer certificate CN did not match", usar false en local.
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identidad de la empresa (login y cabecera — Fase 1)
COMPANY_NAME="${APP_NAME}"
# COMPANY_LEGAL_NAME="Mi Empresa S.A.C."
# COMPANY_TAGLINE="Ventas, compras e inventario"
# COMPANY_LOGO_URL="/LOGO CHOKO HOUSE.png"
# COMPANY_RUC="20611148217"
# COMPANY_ADDRESS="Av. Principal 123, Lima"
# COMPANY_PHONE="976809804"
# COMPANY_EMAIL="ventas@empresa.pe"
# COMPANY_WEBSITE="https://empresa.pe"
# COMPANY_MANAGER_NAME="Nombre Apellido"
# COMPANY_MANAGER_TITLE="Gerente General"
# COMPANY_QUOTATION_VALIDITY="30 días"
# COMPANY_QUOTATION_PAYMENT_TERMS="Transferencia, Yape o PLIN"
# COMPANY_PRIMARY_COLOR="#0f766e"
# COMPANY_LOGIN_BACKGROUND=

# Usuario administrador inicial (seeder)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password"

# Facturación electrónica (CPE) — en local/testing acepta sin SUNAT si es true
# ELECTRONIC_BILLING_FAKE_ACCEPT=false
# OPENSSL_PATH=C:\laragon\bin\git\usr\bin\openssl.exe

